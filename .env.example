# URL do projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publicável/anon do Supabase. Nunca use service_role aqui.
VITE_SUPABASE_ANON_KEY=COLE_SUA_CHAVE_PUBLICA_AQUI

# Nome do repositório do GitHub Pages, incluindo barras.
# Exemplo: /educa-mais/ para https://usuario.github.io/educa-mais/
VITE_BASE_PATH=/educa-mais/
